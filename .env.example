# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file — it's already excluded in .gitignore.
# In production (Vercel), set these under Project Settings > Environment Variables instead.

OPENAI_API_KEY=

# Pinecone (persistent RAG vector store)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=transcription-agent

# Upstash Redis (persistent feedback store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string (16+ chars) used to authorize the Vercel Cron keep-alive request
CRON_SECRET=
