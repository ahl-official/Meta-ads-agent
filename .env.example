# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file — it's already excluded in .gitignore.
# In production (Vercel), set these under Project Settings > Environment Variables instead.

# All OpenAI model calls (chat completions, embeddings) route through OpenRouter
# rather than OpenAI directly — same models, one account/key.
OPENROUTER_API_KEY=

# AssemblyAI (audio transcription for Sir's Global Feedback uploads).
# Free $50 credit on signup, no card required: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Pinecone (persistent RAG vector store)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=transcription-agent

# Upstash Redis (persistent feedback store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string (16+ chars) used to authorize the Vercel Cron keep-alive request
CRON_SECRET=
